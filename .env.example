# API key used by the pi SDK deepseek provider (required for Pi runs).
# Settings (.swarm/settings.json) takes precedence; this env is the fallback.
DEEPSEEK_API_KEY=

# Server (defaults shown; uncomment to override)
#SWARM_PORT=35000
#SWARM_HOST=::
#SWARM_LOG_LEVEL=info
#SWARM_RUN_TIMEOUT_MS=300000
#SWARM_MAX_CONCURRENT_RUNS=4
# Opt-in bearer auth: when set, every API request needs Authorization: Bearer <token>.
#SWARM_AUTH_TOKEN=

# Isolation: inproc (default) or docker. systemd was removed this iteration.
#SWARM_ISOLATION=inproc

# Docker isolation only (SWARM_ISOLATION=docker):
#SWARM_WORKER_IMAGE=node:24-slim
#SWARM_WORKER_MEMORY_MAX=2g
#SWARM_WORKER_CPU_QUOTA=200%
# Worker bundle dir (node + codex + worker.mjs), mounted read-only at /kca/bin.
# Generate with: pnpm build:worker  (outputs dist-worker/)
#SWARM_WORKER_BUNDLE_DIR=./dist-worker
# Debug: keep the kca-* container alive N ms after the run.
#SWARM_WORKER_HOLD_MS=10000

# Agents / Codex (optional):
# codex app-server binary (in docker it is the codex from the mounted bundle).
#SWARM_CODEX_BIN=codex
# Single model for the codex agent (fast/balanced/deep alias is ignored for codex).
#SWARM_CODEX_MODEL=gpt-5-codex
# Shared Codex auth/config home. Defaults to <dataDir>/.swarm/auth/codex/;
# every container mounts the same dir so login happens once.
#CODEX_HOME=

# Git credential token used via GIT_ASKPASS (never written to .swarm).
#SWARM_GIT_TOKEN=
