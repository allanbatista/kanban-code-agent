{
  "name": "kanban-code-agent",
  "version": "0.1.0",
  "type": "module",
  "engines": {
    "node": ">=20.0.0"
  },
  "scripts": {
    "build:src": "tsc -p tsconfig.build.json",
    "build:web": "cd web && npm run build",
    "build": "npm run build:web && npm run build:src",
    "start": "tsx src/cli/index.ts",
    "start:server": "tsx src/cli/index.ts server",
    "start:run": "tsx src/cli/index.ts run",
    "dev": "tsx src/cli/index.ts",
    "dev:all": "trap 'kill 0' EXIT; npm run start:server & (cd web && npm run dev) & wait",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "eslint src/",
    "lint:fix": "eslint src/ --fix",
    "typecheck": "tsc --noEmit",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "devDependencies": {
    "@eslint/js": "^9.0.0",
    "@types/node": "^22.0.0",
    "@types/ws": "^8.18.1",
    "eslint": "^9.0.0",
    "prettier": "^3.0.0",
    "tsx": "^4.0.0",
    "typescript": "^5.5.0",
    "typescript-eslint": "^8.0.0",
    "vitest": "^3.0.0"
  },
  "dependencies": {
    "@earendil-works/pi-coding-agent": "^0.79.10",
    "@fastify/cors": "^11.2.0",
    "@fastify/static": "^9.1.3",
    "@fastify/websocket": "^11.2.0",
    "fastify": "^5.8.5",
    "zod": "^4.4.3"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "@google/genai",
      "esbuild",
      "protobufjs"
    ]
  }
}
